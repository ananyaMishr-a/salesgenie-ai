# Copy this file to ".env" and fill values if you want REAL AI output.
# If you leave OPENAI_API_KEY empty, the app still works fully using
# simple rule-based logic instead of a real LLM (good for a demo/viva).

OPENAI_API_KEY=

# Database file (SQLite - no server install needed)
DATABASE_URL=sqlite:///./salesgenie.db
